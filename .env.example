# Clerk (required for the access gate)
# Create/claim the application at https://dashboard.clerk.com, then copy the keys here.
# Vite only exposes variables prefixed with VITE_ to the browser build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side/CLI only. Never expose this in the client bundle or commit it.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
